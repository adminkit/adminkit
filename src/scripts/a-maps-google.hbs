<script>
  function initMaps() {
    var defaultMap = {
      zoom: 14,
      center: {lat: 40.712784, lng: -74.005941},
      mapTypeId: google.maps.MapTypeId.ROADMAP
    };
    new google.maps.Map(document.getElementById("default_map"), defaultMap);

    var hybridMap = {
      zoom: 14,
      center: {lat: 40.712784, lng: -74.005941},
      mapTypeId: google.maps.MapTypeId.HYBRID
    };
    new google.maps.Map(document.getElementById("hybrid_map"), hybridMap);
  }
</script>

<!-- Without a key Google draws the maps for development only. For production, create an API key
     in Google Cloud, restrict it by HTTP referrer and add key=YOUR_KEY to this URL. -->
<script src="https://maps.googleapis.com/maps/api/js?callback=initMaps&loading=async" async></script>
