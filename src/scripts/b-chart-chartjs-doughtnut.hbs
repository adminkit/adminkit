<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Doughnut chart
    new Chart(document.getElementById("chartjs-doughnut"), {
      type: "doughnut",
      data: {
        labels: ["Social", "Search Engines", "Direct", "Other"],
        datasets: [{
          data: [260, 125, 54, 146],
          backgroundColor: [
            window.theme.{{theme.[0].name}},
            window.theme.{{theme.[2].name}},
            window.theme.{{theme.[4].name}},
            "#dee2e6"
          ],
          borderColor: "transparent"
        }]
      },
      options: {
        maintainAspectRatio: false,
        cutout: "65%",
        plugins: {
          legend: {
            display: false
          }
        }
      }
    });
  });
</script>
