<script>
  document.addEventListener("DOMContentLoaded", function() {
    var ctx = document.getElementById("chartjs-dashboard-line").getContext("2d");

    // Line chart
    adminkit.chartjs("#chartjs-dashboard-line", function(theme) {
      var gradient = ctx.createLinearGradient(0, 0, 0, 225);
      if (theme.id === "light") {
        gradient.addColorStop(0, "rgba(215, 227, 244, 1)");
        gradient.addColorStop(1, "rgba(215, 227, 244, 0)");
      } else {
        gradient.addColorStop(0, "rgba(51, 66, 84, 1)");
        gradient.addColorStop(1, "rgba(51, 66, 84, 0)");
      }

      return {
        type: "line",
        data: {
          labels: ["Jan", "Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],
          datasets: [
            {
              label: "Visitors",
              fill: true,
              backgroundColor: gradient,
              borderColor: theme.primary,
              data: [168400, 159200, 176900, 181300, 174800, 189600, 201200, 196500, 212800, 228400, 219700, 236100]
            }
          ]
        },
        options: {
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              intersect: false
            },
            filler: {
              propagate: false
            }
          },
          scales: {
            x: {
              grid: {
                color: "transparent"
              },
              border: {
                display: false
              }
            },
            y: {
              ticks: {
                stepSize: 20000
              },
              grid: {
                color: "transparent"
              }
            }
          }
        }
      };
    });
  });
</script>
