<div class="card">
  <div class="card-header">
    <h2 class="card-title">Pie Chart</h2>
    <p class="h6 card-subtitle text-body-secondary">Pie charts are excellent at showing the relational proportions between data.</p>
  </div>
  <div class="card-body">
    <div class="chart chart-sm">
      <canvas id="chartjs-pie"></canvas>
    </div>
  </div>
</div>

{{#push "scripts"}}
<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Pie chart
    adminkit.chartjs("#chartjs-pie", function(theme) {
      return {
        type: "pie",
        data: {
          labels: ["Social", "Search Engines", "Direct", "Other"],
          datasets: [{
            data: [260, 125, 54, 146],
            backgroundColor: [
              theme.{{theme.[0].name}},
              theme.{{theme.[4].name}},
              theme.{{theme.[3].name}},
              "#dee2e6"
            ],
            borderColor: "transparent"
          }]
        },
        options: {
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          }
        }
      };
    });
  });
</script>
{{/push}}
