<h1 class="h3 mb-3"><strong>Analytics</strong> Dashboard</h1>

<div class="row">
  <div class="col-xl-6 col-xxl-5 d-flex">
    <div class="w-100">
      <div class="row">
        <div class="col-sm-6">
          {{> dashboard/stats icon="users" title="Visitors" number="48,920" percentage="5.25" percentage-color="success" percentage-text="Since last week" color="primary" }}
          {{> dashboard/stats icon="eye" title="Page views" number="152,384" percentage="6.65" percentage-color="success" percentage-text="Since last week" color="primary" }}
        </div>
        <div class="col-sm-6">
          {{> dashboard/stats icon="log-out" title="Bounce rate" number="41.2%" percentage="-2.25" percentage-color="success" percentage-text="Since last week" color="primary" }}
          {{> dashboard/stats icon="timer" title="Avg. session" number="3.7 min" percentage="-3.65" percentage-color="danger" percentage-text="Since last week" color="primary" }}
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-6 col-xxl-7">
    {{> dashboard/line-chart title="Monthly Visitors" size="sm" }}
  </div>
</div>

<div class="row">
  <div class="col-12 col-md-6 col-xxl-3 d-flex order-2 order-xxl-3">
    {{> dashboard/pie-chart }}
  </div>
  <div class="col-12 col-md-12 col-xxl-6 d-flex order-3 order-xxl-2">
    {{> dashboard/world-map }}
  </div>
  <div class="col-12 col-md-6 col-xxl-3 d-flex order-1 order-xxl-1">
    {{> dashboard/calendar }}
  </div>
</div>

<div class="row">
  <div class="col-12 col-lg-8 col-xxl-9 d-flex">
    {{> dashboard/table-pages }}
  </div>
  <div class="col-12 col-lg-4 col-xxl-3 d-flex">
    {{> dashboard/bar-chart title="Traffic Sources" }}
  </div>
</div>
