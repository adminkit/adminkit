<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col mt-0">
                <h2 class="card-title">{{ title }}</h2>
            </div>

            <div class="col-auto">
                <div class="stat text-{{color}}">
                    <i class="align-middle" data-lucide="{{ icon }}"></i>
                </div>
            </div>
        </div>
        <div class="h1 {{#unless big}}mt-1 mb-3{{/unless}}{{#if big}} mt-2 mb-4{{/if}}">{{ number }}</div>
        <div class="mb-0">
            <span class="text-{{ percentage-color }}">{{ percentage }}%</span>
            <span class="text-body-secondary">{{ percentage-text }}</span>
        </div>
    </div>
</div>