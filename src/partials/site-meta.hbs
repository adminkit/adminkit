<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta name="description" content="{{ meta_description }}">
<meta name="author" content="{{ meta_author }}">
<meta name="keywords" content="{{ meta_keywords }}">

<link rel="shortcut icon" href="/img/icons/icon-48x48.png" />

<link rel="canonical" href="https://demo-basic.adminkit.io/{{#if name}}{{ name }}{{/if}}" />

<title>{{#if title}}{{ title }} | {{/if}}{{ meta_title }}{{#unless title}} - {{ meta_slogan }}{{/unless}}</title>

<!-- Color mode (light, dark or auto), set before the first paint -->
<script>
  (function () {
    var mode;
    try {
      mode = localStorage.getItem("adminkit_config_colorMode");
    } catch (e) {}
    if (mode !== "light" && mode !== "dark") {
      mode = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }
    document.documentElement.setAttribute("data-bs-theme", mode);
  })();
</script>

<link href="/css/app.css" rel="stylesheet">
