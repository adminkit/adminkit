{
  "name": "@adminkit/core",
  "version": "4.1.0",
  "description": "AdminKit - Bootstrap 5 Admin Template",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "bootstrap",
    "bootstrap 5",
    "admin",
    "admin template",
    "dashboard",
    "dashboard template",
    "template",
    "responsive",
    "css",
    "sass",
    "html",
    "theme",
    "front-end",
    "ui kit",
    "web"
  ],
  "homepage": "https://adminkit.io/",
  "bugs": {
    "url": "https://github.com/adminkit/adminkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminkit/adminkit.git"
  },
  "license": "MIT",
  "author": "Paul Laros <support@adminkit.io>",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/js/app.js",
  "types": "./dist/js/app.d.ts",
  "style": "./dist/css/app.css",
  "exports": {
    ".": {
      "types": "./dist/js/app.d.ts",
      "default": "./dist/js/app.js"
    },
    "./css": {
      "types": "./dist/css/app.d.css.ts",
      "default": "./dist/css/app.css"
    },
    "./head": "./dist/js/head.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "*.js"
  ],
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "lint": "eslint . && prettier --check . && node scripts/check-icons.mjs && node scripts/stats.mjs --check",
    "format": "prettier --write .",
    "icons:list": "node scripts/generate-icon-list.mjs",
    "stats": "node scripts/stats.mjs",
    "stats:sync": "node scripts/stats.mjs --sync",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 114",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ],
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "chart.js": "4.6.1",
    "jsvectormap": "1.7.0",
    "lucide": "1.66.0",
    "simplebar": "6.3.3",
    "vanilla-calendar-pro": "3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "gray-matter": "4.0.3",
    "handlebars": "4.7.10",
    "js-beautify": "2.0.3",
    "lefthook": "2.2.2",
    "lucide-static": "1.66.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "sass": "1.107.1",
    "sharp": "0.35.5",
    "vite": "8.3.5",
    "vite-plugin-handlebars": "2.0.3"
  },
  "allowScripts": {
    "lefthook": true
  },
  "adminkit": {
    "edition": "free"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "glob": "14.0.3"
  }
}
