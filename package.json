{
  "name": "@adminkit/core",
  "version": "3.5.0",
  "description": "AdminKit - Bootstrap 5 Admin Template",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "bootstrap",
    "bootstrap 5",
    "admin",
    "admin template",
    "dashboard",
    "dashboard template",
    "template",
    "responsive",
    "css",
    "sass",
    "html",
    "theme",
    "front-end",
    "ui kit",
    "web"
  ],
  "homepage": "https://adminkit.io/",
  "bugs": {
    "url": "https://github.com/adminkit/adminkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adminkit/adminkit.git"
  },
  "license": "MIT",
  "author": "Paul Laros <support@adminkit.io>",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "prepare": "lefthook install",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "browserslist": [
    ">= 0.5%",
    "last 2 major versions",
    "not dead",
    "Chrome >= 60",
    "Firefox >= 60",
    "Firefox ESR",
    "iOS >= 12",
    "Safari >= 12",
    "not Explorer <= 11"
  ],
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "chart.js": "4.6.1",
    "feather-icons": "4.29.2",
    "jsvectormap": "1.7.0",
    "simplebar": "6.3.3",
    "vanilla-calendar-pro": "3.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "autoprefixer": "10.5.4",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "gray-matter": "4.0.3",
    "handlebars": "4.7.10",
    "js-beautify": "2.0.3",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "sass": "1.106.1",
    "vite": "8.3.5",
    "vite-plugin-handlebars": "2.0.3"
  }
}
