{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/icons-feather",
      "destination": "/icons-lucide",
      "permanent": true
    },
    {
      "source": "/icons-feather.html",
      "destination": "/icons-lucide",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:path+",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
